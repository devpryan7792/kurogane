#!/usr/bin/env bash

build() {
    add_module 'exfat'
    add_module 'erofs'
    add_module 'loop'
    add_module 'ext4'
    add_module 'virtio_blk'
    add_module 'virtio_pci'
    add_binary 'blkid'
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    PARENT_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
    if [[ -f "${PARENT_DIR}/hub_loader.sh" ]]; then
        HUB_LOADER="${PARENT_DIR}/hub_loader.sh"
    elif [[ -f "${PARENT_DIR}/kurogane/hub_loader.sh" ]]; then
        HUB_LOADER="${PARENT_DIR}/kurogane/hub_loader.sh"
    else
        HUB_LOADER="${PARENT_DIR}/cartilage/hub_loader.sh"
    fi
    if [[ ! -f "$HUB_LOADER" ]]; then
        echo "Error: hub_loader.sh not found at ${HUB_LOADER}" >&2
        return 1
    fi
    add_file "$HUB_LOADER" "/hub_loader.sh" 755
    add_runscript
}

help() {
    cat <<HELPEOF
Cartilage OS Dynamic Hub bootstrap hook.
Discovers CARTRIDGES exFAT volume, renders TTY text menu, loop-mounts chosen appliance.
HELPEOF
}
